modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "FlowSOP AI"

[[workflows.workflow]]
name = "FlowSOP AI"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- --host 0.0.0.0 --port 5173"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "webview"

[nix]
channel = "stable-25_05"
